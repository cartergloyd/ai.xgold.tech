[Unit]
Description=xGold AI monthly invoices and Twenty copy
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/home/gold/server-platform/gateway/gateway.env
ExecStart=/home/gold/.local/node/bin/node --max-old-space-size=96 /home/gold/server-platform/ai-site-src/gateway/invoice.mjs
WorkingDirectory=/home/gold/server-platform/ai-site-src
MemoryMax=192M
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
