# Copy to .env on the server. Never commit .env.
# Pin a release from https://hub.docker.com/r/twentycrm/twenty/tags (not "latest") before going live.
TAG=latest

SERVER_URL=https://crm.xgold.tech

# openssl rand -hex 32  (no @ / # % characters; it is pasted into the Postgres URL as-is)
PG_DATABASE_PASSWORD=replace_me
PG_DATABASE_USER=postgres
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
REDIS_URL=redis://redis:6379

# openssl rand -base64 32 — losing this loses every stored secret (OAuth tokens, TOTP). Back it up.
ENCRYPTION_KEY=replace_me
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=

STORAGE_TYPE=local

# Optional: outbound email for invites and password resets.
# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=crm@xgold.tech
# EMAIL_FROM_NAME=xGold Tech CRM
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
